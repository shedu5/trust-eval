# Copy to .env and edit. Used by docker-compose.

# Comma-separated judge specs "<provider>:<model>". Set to models you can access.
TRUST_EVAL_PROVIDERS=anthropic:claude-sonnet-placeholder,openai:gpt-placeholder

# Set to 1 to fill cache misses with live API calls (needs the keys below).
# Leave 0 to reproduce committed tables from the response cache with no key.
TRUST_EVAL_LIVE=0

# Only needed for live runs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
