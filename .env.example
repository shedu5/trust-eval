# Copy to .env and edit. Used by docker-compose.

# Comma-separated judge specs "<provider>:<model>". Supported providers:
#   deepseek  (OpenAI-compatible)  key: DEEPSEEK_API_KEY
#   gemini    (OpenAI-compatible)  key: GEMINI_API_KEY
#   openai                         key: OPENAI_API_KEY
#   anthropic                      key: ANTHROPIC_API_KEY
TRUST_EVAL_PROVIDERS=deepseek:deepseek-v4-flash,gemini:gemini-3.1-flash

# Set to 1 to fill cache misses with live API calls (needs the keys below).
# Leave 0 to reproduce committed tables from the response cache with no key.
TRUST_EVAL_LIVE=1

# Only the keys for the providers you actually use are needed.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
